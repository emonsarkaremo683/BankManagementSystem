<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EnSarkBank" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/electric_cyan</item>
        <item name="colorOnPrimary">@color/primary_background</item>
        <item name="colorSecondary">@color/neon_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/mint_green</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorSurface">@color/surface_background</item>
        <item name="colorSurfaceVariant">@color/surface_background</item>
        <item name="colorSurfaceContainer">@color/surface_background</item>
        <item name="colorSurfaceContainerHigh">@color/surface_background</item>
        <item name="colorSurfaceContainerHighest">@color/surface_background</item>
        <item name="colorSurfaceContainerLow">@color/surface_background</item>
        <item name="colorSurfaceContainerLowest">@color/surface_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:popupBackground">@color/surface_background</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/primary_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="autoCompleteTextViewStyle">@style/CustomAutoComplete</item>
    </style>

    <style name="CustomAutoComplete" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox">
        <item name="android:popupBackground">@color/surface_background</item>
    </style>
</resources>
