<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EnSarkBank" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary_light</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSecondaryContainer">@color/brand_primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_primary</item>

        <!-- Surfaces & text -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/danger</item>

        <!-- System bars: blue backdrop with light icons -->
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Default widget styles -->
        <item name="materialCardViewStyle">@style/Widget.EnsarkBank.Card</item>
        <item name="textInputStyle">@style/Widget.EnsarkBank.TextInputLayout</item>
    </style>

</resources>
