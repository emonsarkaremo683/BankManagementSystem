<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ Typography ============ -->

    <style name="TextAppearance.EnsarkBank" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.ScreenTitle">
        <item name="android:textSize">22sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.SectionHeader">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.Balance">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.EnsarkBank.Button">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.EnsarkBank.OnBrand">
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="TextAppearance.EnsarkBank.AmountCredit">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/success</item>
    </style>

    <style name="TextAppearance.EnsarkBank.AmountDebit">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- ============ Cards ============ -->

    <style name="Widget.EnsarkBank.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="rippleColor">@color/brand_primary_soft</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.EnsarkBank.Card.Balance">
        <item name="cardCornerRadius">@dimen/corner_hero</item>
        <item name="cardElevation">@dimen/elevation_hero</item>
        <item name="contentPadding">@dimen/card_padding_hero</item>
    </style>

    <style name="Widget.EnsarkBank.Card.Static">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- ============ Buttons ============ -->

    <style name="Widget.EnsarkBank.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.EnsarkBank.Button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.EnsarkBank.Button.Primary">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Widget.EnsarkBank.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.EnsarkBank.Button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="rippleColor">@color/brand_primary_soft</item>
    </style>

    <style name="Widget.EnsarkBank.Button.Danger">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Widget.EnsarkBank.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.EnsarkBank.Button</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- ============ Inputs ============ -->

    <style name="Widget.EnsarkBank.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_input</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:minHeight">@dimen/input_height</item>
    </style>

    <!-- ============ Status chips ============ -->

    <style name="Widget.EnsarkBank.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="Widget.EnsarkBank.Chip.Status.Success">
        <item name="chipBackgroundColor">@color/success_soft</item>
        <item name="android:textColor">@color/success</item>
    </style>

    <style name="Widget.EnsarkBank.Chip.Status.Pending">
        <item name="chipBackgroundColor">@color/warning_soft</item>
        <item name="android:textColor">@color/warning</item>
    </style>

    <style name="Widget.EnsarkBank.Chip.Status.Failed">
        <item name="chipBackgroundColor">@color/danger_soft</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Widget.EnsarkBank.Chip.Status.Info">
        <item name="chipBackgroundColor">@color/info_soft</item>
        <item name="android:textColor">@color/info</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
