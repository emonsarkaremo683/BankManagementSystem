<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/chequeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cheque Services"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chequeBooksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/requestChequeButton"
        app:layout_constraintTop_toBottomOf="@id/chequeTitle" />

    <Button
        android:id="@+id/requestChequeButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/neumorphic_button_selector"
        android:text="Request New Cheque Book"
        android:textAllCaps="false"
        android:textColor="@color/primary_background"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
