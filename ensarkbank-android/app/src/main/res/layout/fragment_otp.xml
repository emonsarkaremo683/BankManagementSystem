<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/otpTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Verification Code"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/otpSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter the 6-digit code sent to your email"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/otpTitle" />

    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/otpSubtitle">

        <!-- Individual Digit Cells -->
        <EditText
            android:id="@+id/otpDigit1"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/neumorphic_recessed"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigit2"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/neumorphic_recessed"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigit3"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/neumorphic_recessed"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigit4"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/neumorphic_recessed"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigit5"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/neumorphic_recessed"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/otpDigit6"
            android:layout_width="45dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:background="@drawable/neumorphic_recessed"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/electric_cyan"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/verifyButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/neumorphic_button_selector"
        android:text="Verify &amp; Confirm"
        android:textAllCaps="false"
        android:textColor="@color/primary_background"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/otpContainer" />

    <TextView
        android:id="@+id/resendText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Didn't receive code? Resend"
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/verifyButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
