<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primary_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Beneficiary"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/typeLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Beneficiary Type"
        app:hintTextColor="@color/electric_cyan"
        app:layout_constraintTop_toBottomOf="@id/dialogTitle">

        <AutoCompleteTextView
            android:id="@+id/typeAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/neumorphic_recessed"
            android:inputType="none"
            android:padding="16dp"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <EditText
        android:id="@+id/nameEditText"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/neumorphic_recessed"
        android:hint="Full Name"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/typeLayout" />

    <EditText
        android:id="@+id/accNoEditText"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/neumorphic_recessed"
        android:hint="Account / Card / Wallet No"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/nameEditText" />

    <EditText
        android:id="@+id/providerEditText"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/neumorphic_recessed"
        android:hint="Provider (Bank/MFS Name)"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/accNoEditText" />

    <EditText
        android:id="@+id/routingEditText"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/neumorphic_recessed"
        android:hint="Routing Number (Optional)"
        android:padding="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/providerEditText" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/neumorphic_button_selector"
        android:text="Save Beneficiary"
        android:textAllCaps="false"
        android:textColor="@color/primary_background"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/routingEditText" />

</androidx.constraintlayout.widget.ConstraintLayout>