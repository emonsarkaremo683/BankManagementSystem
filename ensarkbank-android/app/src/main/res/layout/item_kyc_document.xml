<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/neumorphic_raised"
    android:padding="16dp">

    <ImageView
        android:id="@+id/docIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_cheque"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/electric_cyan" />

    <TextView
        android:id="@+id/docTypeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="DOCUMENT TYPE"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/docIcon"
        app:layout_constraintTop_toTopOf="@id/docIcon" />

    <TextView
        android:id="@+id/docStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPLOADED"
        android:textColor="@color/mint_green"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/docIcon"
        app:layout_constraintStart_toStartOf="@id/docTypeText" />

</androidx.constraintlayout.widget.ConstraintLayout>