<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/createAccountTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_new_account"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/accountTypeLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/account_type"
            app:hintTextColor="@color/electric_cyan"
            app:layout_constraintTop_toBottomOf="@id/createAccountTitle">

            <AutoCompleteTextView
                android:id="@+id/accountTypeAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/neumorphic_recessed"
                android:inputType="none"
                android:padding="16dp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/branchLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/select_branch"
            app:hintTextColor="@color/electric_cyan"
            app:layout_constraintTop_toBottomOf="@id/accountTypeLayout">

            <AutoCompleteTextView
                android:id="@+id/branchAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/neumorphic_recessed"
                android:inputType="none"
                android:padding="16dp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <EditText
            android:id="@+id/initialDepositEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/neumorphic_recessed"
            android:hint="@string/initial_deposit"
            android:inputType="numberDecimal"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/branchLayout" />

        <TextView
            android:id="@+id/applicantDocsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Applicant Documents"
            android:textColor="@color/electric_cyan"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/initialDepositEditText" />

        <LinearLayout
            android:id="@+id/applicantDocsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/applicantDocsLabel">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnUploadSignature"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:background="@drawable/neumorphic_recessed">
                <ImageView
                    android:id="@+id/imgSignature"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="Signature"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/txtSignature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signature"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.8"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/nomineeSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/nominee_info"
            android:textColor="@color/electric_cyan"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/applicantDocsContainer" />

        <EditText
            android:id="@+id/nomineeNameEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/neumorphic_recessed"
            android:hint="@string/nominee_name"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/nomineeSectionLabel" />

        <EditText
            android:id="@+id/nomineeEmailEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/neumorphic_recessed"
            android:hint="@string/nominee_email"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/nomineeNameEditText" />

        <EditText
            android:id="@+id/nomineePhoneEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/neumorphic_recessed"
            android:hint="@string/nominee_phone"
            android:inputType="phone"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            app:layout_constraintTop_toBottomOf="@id/nomineeEmailEditText" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/relationLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/relation_nominee"
            app:hintTextColor="@color/electric_cyan"
            app:layout_constraintTop_toBottomOf="@id/nomineePhoneEditText">

            <AutoCompleteTextView
                android:id="@+id/relationAutoComplete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/neumorphic_recessed"
                android:inputType="none"
                android:padding="16dp"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/nomineeDocsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/nominee_docs"
            android:textColor="@color/electric_cyan"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/relationLayout" />

        <LinearLayout
            android:id="@+id/nomineeDocsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/nomineeDocsLabel">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnUploadNomineePhoto"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/neumorphic_recessed">
                <ImageView
                    android:id="@+id/imgNomineePhoto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/photo"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/txtPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.8"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnUploadNomineeNidFront"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/neumorphic_recessed">
                <ImageView
                    android:id="@+id/imgNidFront"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/nid_front"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/txtNidFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nid_front"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.8"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnUploadNomineeNidBack"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/neumorphic_recessed">
                <ImageView
                    android:id="@+id/imgNidBack"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/nid_back"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/txtNidBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nid_back"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.8"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nomineeDocsContainer">

            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/neumorphic_button_selector"
                android:text="@string/submit_application"
                android:textAllCaps="false"
                android:textColor="@color/primary_background"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/primary_background" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>