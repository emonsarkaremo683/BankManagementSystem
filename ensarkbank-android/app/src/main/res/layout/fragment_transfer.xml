<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/transferTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send Money"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/beneficiaryDropdownLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Select Beneficiary"
        app:hintTextColor="@color/electric_cyan"
        app:layout_constraintTop_toBottomOf="@id/transferTitle">

        <AutoCompleteTextView
            android:id="@+id/beneficiaryAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/neumorphic_recessed"
            android:inputType="none"
            android:padding="16dp"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <EditText
        android:id="@+id/amountEditText"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/neumorphic_recessed"
        android:gravity="center"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:textColor="@color/electric_cyan"
        android:textColorHint="@color/text_secondary"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/beneficiaryDropdownLayout" />

    <Button
        android:id="@+id/sendButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/neumorphic_button_selector"
        android:text="Transfer Now"
        android:textAllCaps="false"
        android:textColor="@color/primary_background"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/amountEditText" />

</androidx.constraintlayout.widget.ConstraintLayout>
