<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Background (Canvas) -->
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/primary_background" />
        </shape>
    </item>

    <!-- Top-left inner shadow (Simulated) -->
    <item
        android:bottom="2dp"
        android:right="2dp">
        <shape>
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/shadow_dark" />
        </shape>
    </item>

    <!-- Bottom-right inner highlight (Simulated) -->
    <item
        android:top="2dp"
        android:left="2dp">
        <shape>
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/shadow_light" />
        </shape>
    </item>
</layer-list>
