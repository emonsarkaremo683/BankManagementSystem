<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: Glow Cyan -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="999dp" />
                    <solid android:color="@color/shadow_cyan" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape>
                    <corners android:radius="999dp" />
                    <solid android:color="@color/electric_cyan" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state: Recessed -->
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="999dp" />
                    <solid android:color="@color/surface_background" />
                    <stroke android:width="1dp" android:color="@color/shadow_light" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
